# Vision-specific Dockerfile - CPU only for Windows compatibility
FROM python:3.11-slim-bookworm AS vision-base

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    # OpenCV dependencies
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1-mesa-glx \
    libglib2.0-dev \
    # ONNX Runtime dependencies
    libprotobuf-dev \
    protobuf-compiler \
    # Screen capture
    libx11-dev \
    libxext-dev \
    libxfixes-dev \
    libxdamage-dev \
    libxcomposite-dev \
    libxrandr-dev \
    libxi-dev \
    libxtst-dev \
    # Build tools
    build-essential \
    cmake \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install ONNX Runtime CPU from PyPI
ARG ONNX_VERSION=1.18.0
RUN pip3 install --no-cache-dir \
    onnxruntime==${ONNX_VERSION}

WORKDIR /opt/hcs/vision
COPY vision/requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

COPY vision/ .
RUN python3 -m compileall .

EXPOSE 50051 50052

CMD ["python3", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "50051", "--workers", "4"]